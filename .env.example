# Production Compose settings. Copy to .env on the VM.
SITE_DOMAIN=symcomp.ime.usp.br
POSTGRES_DB=symcomp_db
POSTGRES_USER=symcomp_user
# Generate each value separately with: openssl rand -hex 32
# Hex avoids URL-encoding issues in the database connection string.
POSTGRES_PASSWORD=
SECRET_KEY=
# Optional: change if this subnet overlaps an existing Docker/VPN network.
COMPOSE_SUBNET=172.30.0.0/24
